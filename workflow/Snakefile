configfile: "config/config.yaml"

VARIABLES = {v["name"]: v["type"] for v in config["variables"]}
CATEGORICAL_VARIABLES = [v for v, t in VARIABLES.items() if t == "categorical"]
CONTINUOUS_VARIABLES  = [v for v, t in VARIABLES.items() if t == "continuous"]


rule all:
    input:
        "data/processed/metabolomics_tvas.csv",
        "data/processed/clinical_tvas.csv",
        "data/processed/clinical_guide.csv",
        "data/processed/clinical_tvas_transformed.csv",
        "data/processed/transcriptomics_tvas.csv",
        expand("results/metabolomics/limma/{variable}/done.txt",
               variable=VARIABLES.keys()),
        expand("results/proteomics/limma/{variable}/done.txt",
               variable=VARIABLES.keys()),
        expand("results/transcriptomics/deseq2/{variable}/done.txt",
               variable=CATEGORICAL_VARIABLES),
        expand("results/transcriptomics/deseq2/{variable}/{variable}_results.csv",
               variable=CONTINUOUS_VARIABLES),
        "results/transcriptomics/summary_heatmap.png",
        "results/clinics/descriptive/continuous.csv",
        "results/clinics/descriptive/categorical.csv",
        "results/clinics/descriptive_stratified/descriptive_table_stratified.csv",
        "results/clinics/qc/continuous_distributions.png",
        "results/metabolomics/summary_heatmap.png",
        "results/proteomics/summary_heatmap.png",
        "results/metabolomics/metabolomics_limma_results.xlsx",
        "results/proteomics/proteomics_limma_results.xlsx",
        "results/transcriptomics/transcriptomics_deseq2_results.xlsx",
        "results/report/atheromics_tvas_report.html"


rule preprocess_metabolomics:
    input:
        "data/raw/metabolomics/log_transformed_data.csv"
    output:
        "data/processed/metabolomics_tvas.csv"
    script:
        "scripts/preprocess_metabolomics.py"


rule preprocess_clinical:
    input:
        "data/raw/metabolon e glicemia 090926_rev_LA.xlsx",
        "data/processed/metabolomics_tvas.csv"
    output:
        "data/processed/clinical_tvas.csv",
        "data/processed/clinical_guide.csv",
        "data/processed/clinical_tvas_transformed.csv"
    script:
        "scripts/preprocess_clinical.py"


rule preprocess_proteomics:
    input:
        "data/raw/proteomics/FedericiAllPlates_Extended_NPX_2026-03-11.csv",
        "data/processed/metabolomics_tvas.csv"
    output:
        "data/processed/proteomics_all.csv",
        "data/processed/proteomics_tvas.csv"
    script:
        "scripts/preprocess_proteomics.py"


rule preprocess_transcriptomics:
    input:
        "data/raw/transcriptomics/featureCounts_napoli_harmonized_qcfilt.tsv",
        "data/processed/metabolomics_tvas.csv"
    output:
        "data/processed/transcriptomics_tvas.csv"
    script:
        "scripts/preprocess_transcriptomics.py"


rule descriptive_clinical:
    input:
        clinical = "data/processed/clinical_tvas.csv",
        guide    = "data/processed/clinical_guide.csv"
    output:
        "results/clinics/descriptive/continuous.csv",
        "results/clinics/descriptive/categorical.csv"
    script:
        "scripts/descriptive_clinical.py"


rule descriptive_clinical_stratified:
    input:
        clinical = "data/processed/clinical_tvas.csv",
        guide    = "data/processed/clinical_guide.csv"
    output:
        "results/clinics/descriptive_stratified/descriptive_table_stratified.csv"
    params:
        strat_var    = config["stratified_descriptive"]["strat_var"],
        group_labels = config["stratified_descriptive"]["group_labels"],
        exclude      = config["stratified_descriptive"]["exclude"],
        out_dir      = "results/clinics/descriptive_stratified/",
        script       = "workflow/scripts/clinical_descriptive_stratified.py"
    shell:
        """
        python {params.script} \
            --input        {input.clinical} \
            --guide        {input.guide} \
            --strat_var    {params.strat_var} \
            --group_labels "{params.group_labels}" \
            --exclude      {params.exclude} \
            --out_dir      {params.out_dir}
        """


rule summary_heatmap:
    input:
        expand("results/{omic}/limma/{variable}/done.txt",
               variable=VARIABLES.keys(), allow_missing=True)
    output:
        "results/{omic}/summary_heatmap.png"
    params:
        results_dir = "results/{omic}/limma/",
        script      = "workflow/scripts/summary_heatmap.py"
    shell:
        """
        python {params.script} \
            --omic    {wildcards.omic} \
            --results {params.results_dir} \
            --out     {output}
        """


rule clinical_continuous_qc:
    input:
        clinical = "data/processed/clinical_tvas.csv"
    output:
        "results/clinics/qc/continuous_distributions.png"
    script:
        "scripts/clinical_continuous_diagnostics.py"


rule consolidate_excel:
    input:
        expand("results/{omic}/limma/{variable}/done.txt",
               variable=VARIABLES.keys(), allow_missing=True)
    output:
        "results/{omic}/{omic}_limma_results.xlsx"
    params:
        results_dir = "results/{omic}/limma/",
        script      = "workflow/scripts/consolidate_excel.py"
    shell:
        """
        python {params.script} \
            --omic    {wildcards.omic} \
            --results {params.results_dir} \
            --out     {output}
        """


rule rnaseq_consolidate_excel:
    input:
        expand("results/transcriptomics/deseq2/{variable}/done.txt",
               variable=CATEGORICAL_VARIABLES),
        expand("results/transcriptomics/deseq2/{variable}/{variable}_results.csv",
               variable=CONTINUOUS_VARIABLES)
    output:
        "results/transcriptomics/transcriptomics_deseq2_results.xlsx"
    params:
        results_dir = "results/transcriptomics/deseq2/",
        script      = "workflow/scripts/rnaseq_consolidate_excel.py"
    shell:
        """
        python {params.script} \
            --results {params.results_dir} \
            --out     {output}
        """


rule report_html:
    input:
        continuous  = "results/clinics/descriptive/continuous.csv",
        categorical = "results/clinics/descriptive/categorical.csv",
        stratified  = "results/clinics/descriptive_stratified/descriptive_table_stratified.csv",
        qc_grid     = "results/clinics/qc/continuous_distributions.png",
        heatmap_met = "results/metabolomics/summary_heatmap.png",
        heatmap_pro = "results/proteomics/summary_heatmap.png",
        heatmap_tra = "results/transcriptomics/summary_heatmap.png"
    output:
        "results/report/atheromics_tvas_report.html"
    script:
        "scripts/make_html_report.py"


rule limma_proteomics:
    input:
        data  = "data/processed/proteomics_tvas.csv",
        meta  = "data/processed/clinical_tvas_transformed.csv"
    output:
        "results/proteomics/limma/{variable}/done.txt"
    params:
        var_type   = lambda wc: VARIABLES[wc.variable],
        covariates = config["covariates"],
        out_dir    = "results/proteomics/limma/{variable}/",
        script     = "workflow/scripts/proteomics_limma.R"
    shell:
        """
        Rscript {params.script} \
            --variable   {wildcards.variable} \
            --type       {params.var_type} \
            --covariates {params.covariates} \
            --input      {input.data} \
            --metadata   {input.meta} \
            --out_dir    {params.out_dir} \
        && touch {output}
        """


rule rnaseq_deseq2:
    input:
        data  = "data/processed/transcriptomics_tvas.csv",
        meta  = "data/processed/clinical_tvas_transformed.csv"
    output:
        "results/transcriptomics/deseq2/{variable}/done.txt"
    params:
        covariates = config["covariates"],
        annotation = "data/raw/transcriptomics/gene_annotation.csv",
        out_dir    = "results/transcriptomics/deseq2/{variable}/",
        script     = "workflow/scripts/rnaseq_deseq2.R"
    shell:
        """
        Rscript {params.script} \
            --variable   {wildcards.variable} \
            --covariates {params.covariates} \
            --matrix     {input.data} \
            --metadata   {input.meta} \
            --annotation {params.annotation} \
            --out_dir    {params.out_dir} \
        && touch {output}
        """


rule rnaseq_deseq2_continuous:
    input:
        data  = "data/processed/transcriptomics_tvas.csv",
        meta  = "data/processed/clinical_tvas_transformed.csv"
    output:
        "results/transcriptomics/deseq2/{variable}/{variable}_results.csv"
    params:
        covariates = config["covariates"],
        annotation = "data/raw/transcriptomics/gene_annotation.csv",
        out_dir    = "results/transcriptomics/deseq2/{variable}/",
        script     = "workflow/scripts/rnaseq_deseq2_continuous.R"
    shell:
        """
        Rscript {params.script} \
            --variable   {wildcards.variable} \
            --covariates {params.covariates} \
            --matrix     {input.data} \
            --metadata   {input.meta} \
            --annotation {params.annotation} \
            --out_dir    {params.out_dir}
        """


rule rnaseq_summary_heatmap:
    input:
        expand("results/transcriptomics/deseq2/{variable}/done.txt",
               variable=CATEGORICAL_VARIABLES),
        expand("results/transcriptomics/deseq2/{variable}/{variable}_results.csv",
               variable=CONTINUOUS_VARIABLES)
    output:
        "results/transcriptomics/summary_heatmap.png"
    params:
        results_dir = "results/transcriptomics/deseq2/",
        script      = "workflow/scripts/rnaseq_summary_heatmap.py"
    shell:
        """
        python {params.script} \
            --results {params.results_dir} \
            --out     {output}
        """


rule limma_metabolomics:
    input:
        data       = "data/processed/metabolomics_tvas.csv",
        meta       = "data/processed/clinical_tvas_transformed.csv",
        annotation = "data/raw/metabolomics/chemical_metadata.csv"
    output:
        "results/metabolomics/limma/{variable}/done.txt"
    params:
        var_type   = lambda wc: VARIABLES[wc.variable],
        covariates = config["covariates"],
        out_dir    = "results/metabolomics/limma/{variable}/",
        script     = "workflow/scripts/metabolomics_limma.R"
    shell:
        """
        Rscript {params.script} \
            --variable   {wildcards.variable} \
            --type       {params.var_type} \
            --covariates {params.covariates} \
            --input      {input.data} \
            --metadata   {input.meta} \
            --annotation {input.annotation} \
            --out_dir    {params.out_dir} \
        && touch {output}
        """
